# Vzor konfigurace – zkopírovat do .env a doplnit. Soubor .env se necommituje.
PORT=3000

# MongoDB Atlas: Database → Connect → Drivers → connection string (s uživatelem a heslem databáze)
MONGODB_URI=mongodb+srv://<uzivatel>:<heslo>@<cluster>.mongodb.net/escape-room-iot?retryWrites=true&w=majority

# Tajný klíč pro podpis JWT – dlouhý náhodný řetězec, v produkci povinný.
# Vygenerovat: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Platnost přihlášení uživatele (výchozí 12h)
JWT_EXPIRES_IN=12h
